<view class="page poster-page">
  <view class="poster-head">
    <text class="tiny-label">{{poster.style}}</text>
    <text class="screen-title">你的火锅朋友圈海报</text>
    <text class="muted">保存到相册后，可以自由分享。</text>
  </view>

  <view class="poster-card section">
    <view class="poster-photo">
      <image src="/assets/brand/ip/liaoxiaoxing-standalone-no-star.png" mode="aspectFit" />
      <view>
        <text>今日份快乐</text>
        <text>由肉治愈</text>
      </view>
    </view>
    <view class="poster-copy">
      <text>{{poster.copy}}</text>
    </view>
    <view class="poster-footer">
      <view>
        <text class="store-name">{{store.name}}</text>
        <text class="muted">{{store.slogan}}</text>
      </view>
      <view class="mini-code">码</view>
    </view>
  </view>

  <button class="primary-btn section" bindtap="savePoster">保存到相册</button>
  <view class="double-actions">
    <button class="secondary-btn" bindtap="copyText">复制文案</button>
    <button class="secondary-btn" bindtap="regenerate">再生成一次</button>
  </view>

  <canvas type="2d" id="posterCanvas" class="poster-canvas"></canvas>
</view>
