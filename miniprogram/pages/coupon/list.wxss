.wallet-copy {
  display: flex;
  max-width: 330rpx;
  flex-direction: column;
  gap: 9rpx;
}

.wallet-title {
  color: var(--lk-ink-900);
  font-size: 48rpx;
  font-weight: 900;
}

.wallet-count {
  color: var(--lk-ember-600);
  font-size: 29rpx;
  font-weight: 900;
}

.segment {
  display: flex;
  gap: 6rpx;
  padding: 8rpx;
}

.segment button {
  flex: 1;
}

.coupon-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.empty-state {
  display: flex;
  min-height: 300rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.verify-note {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 22rpx 24rpx;
}

.verify-note > view {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 7rpx;
  font-size: 29rpx;
  font-weight: 900;
}

.verify-note .muted {
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1.48;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(31, 31, 35, 0.5);
}

.code-modal {
  display: flex;
  width: 100%;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
  padding: 42rpx;
  border-radius: 38rpx;
}

.code-title {
  font-size: 36rpx;
  font-weight: 900;
}

.code-benefit {
  color: #ff4b1b;
  font-size: 52rpx;
  font-weight: 900;
}

.fake-qrcode {
  display: flex;
  width: 360rpx;
  height: 360rpx;
  align-items: center;
  justify-content: center;
  border: 18rpx solid #1f1f23;
  background: repeating-linear-gradient(45deg, #1f1f23 0 16rpx, #fff 16rpx 32rpx);
}

.fake-qrcode text {
  padding: 12rpx 18rpx;
  background: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
}
