<view class="page with-tab ai-page">
  <view class="screen-head">
    <view>
      <text class="tiny-label">燎小星创作台</text>
      <text class="screen-title">今天这顿火锅，值得被记住</text>
      <text class="muted">上传随手拍，也可以只写一句真实感受。</text>
    </view>
    <image src="/assets/brand/ip/liaoxiaoxing-standalone-no-star.png" mode="aspectFit" />
  </view>

  <button class="upload-card section" bindtap="chooseImage">
    <image wx:if="{{imagePath}}" src="{{imagePath}}" mode="aspectFill" />
    <view wx:else>
      <text class="upload-icon">+</text>
      <text class="upload-title">上传/拍一张火锅照片</text>
      <text class="muted">支持美食、环境、合影</text>
    </view>
    <text wx:if="{{uploadStatus === 'uploading'}}" class="upload-state">上传中</text>
    <text wx:if="{{uploadStatus === 'done'}}" class="upload-state done">已上传</text>
    <text wx:if="{{uploadStatus === 'failed'}}" class="upload-state failed">上传失败</text>
  </button>

  <view class="input-card card section">
    <text class="input-label">说一句你的真实感受</text>
    <textarea value="{{feeling}}" maxlength="80" auto-height bindinput="updateFeeling" />
    <view class="preset-row">
      <button wx:for="{{presets}}" wx:key="*this" data-text="{{item}}" bindtap="usePreset">{{item}}</button>
    </view>
  </view>

  <view class="style-panel section">
    <text class="input-label">选择风格</text>
    <view class="style-grid">
      <button
        wx:for="{{styles}}"
        wx:key="*this"
        class="{{activeStyle === item ? 'active' : ''}}"
        data-style="{{item}}"
        bindtap="chooseStyle"
      >{{item}}</button>
    </view>
  </view>

  <button class="primary-btn section" bindtap="generate">生成我的朋友圈素材</button>

  <mascot-card
    compact
    title="安全提示"
    image-src="/assets/brand/ip/liaoxiaoxing-standalone-no-star.png"
    text="生成内容会避开强制分享、虚假宣传和敏感表达。"
  />
</view>
