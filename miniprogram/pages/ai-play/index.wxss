.hero-copy {
  display: flex;
  max-width: 350rpx;
  flex-direction: column;
  gap: 10rpx;
}

.ai-label {
  color: #007b9e;
}

.screen-title {
  color: var(--lk-ink-900);
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.18;
}

.upload-card {
  position: relative;
  display: flex;
  min-height: 360rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: var(--lk-radius-md);
  background: radial-gradient(circle at 50% 35%, rgba(0, 194, 255, .10), transparent 48%);
}

.upload-state {
  position: absolute;
  right: 22rpx;
  top: 22rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 123, 158, 0.86);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
}

.upload-state.done {
  background: rgba(0, 123, 158, 0.92);
}

.upload-state.failed {
  background: rgba(145, 32, 20, 0.9);
}

.upload-card image {
  width: 100%;
  height: 360rpx;
}

.upload-card view {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.upload-title,
.input-label {
  color: var(--lk-ink-900);
  font-size: 30rpx;
  font-weight: 900;
}

.input-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 28rpx;
}

textarea {
  width: 100%;
  min-height: 132rpx;
  color: #33343a;
  font-size: 29rpx;
  line-height: 1.55;
}

.preset-row,
.style-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.preset-row button,
.style-grid button {
  padding: 18rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .72);
  color: var(--lk-ink-600);
  font-size: 24rpx;
  font-weight: 700;
}

.style-panel {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 28rpx;
}

.style-grid .active {
  background: #007b9e;
  color: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(0, 123, 158, .18);
}

.safety-note {
  display: block;
  margin-top: 16rpx;
  color: var(--lk-ink-600);
  font-size: 21rpx;
  text-align: center;
}
