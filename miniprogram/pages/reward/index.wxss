.points-copy {
  display: flex;
  max-width: 310rpx;
  flex-direction: column;
  gap: 9rpx;
}

.points {
  color: var(--lk-ink-900);
  font-size: 82rpx;
  font-weight: 900;
  line-height: 1;
}

.points-unit {
  color: #8a5b00;
  font-size: 24rpx;
  font-weight: 800;
}

.mall-entry {
  display: flex;
  min-height: 148rpx;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 24rpx;
}

.mall-entry > view {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.mall-entry .muted {
  font-size: 22rpx;
  font-weight: 500;
}

.entry-arrow {
  color: var(--lk-ember-600);
  font-size: 46rpx;
}

.progress-card {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 28rpx;
}

.progress-title {
  font-size: 30rpx;
  font-weight: 900;
}

.progress-track {
  height: 20rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #f1e8da;
}

.progress-track view {
  width: 64%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #ff4b1b, #f8b84d);
}

.task-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.task-card {
  display: flex;
  min-height: 248rpx;
  align-items: center;
  flex-direction: column;
  justify-content: space-between;
  padding: 20rpx;
  text-align: center;
}

.task-title {
  color: #1f1f23;
  font-size: 29rpx;
  font-weight: 900;
}

.task-card button {
  padding: 16rpx 20rpx;
  border-radius: 999rpx;
  background: var(--lk-cream-100);
  color: var(--lk-ember-600);
  font-size: 24rpx;
  font-weight: 800;
}

.points-history {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 28rpx;
}

.points-history > .split-row {
  padding-bottom: 18rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.points-history > view:not(.split-row) {
  display: flex;
  min-height: 82rpx;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid var(--lk-line);
  font-size: 25rpx;
}

.plus {
  color: #8a5b00;
  font-weight: 900;
}
