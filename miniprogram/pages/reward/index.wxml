<view class="page with-tab reward-page {{reduceMotion ? 'reduce-motion' : ''}}">
  <lk-liaoxiaoxing-moment scene-id="points">
    <view class="points-copy">
      <text class="tiny-label">LIAOKE POINTS</text>
      <text class="points">{{member.points}}</text>
      <text class="points-unit">可用积分 · {{member.level}}</text>
    </view>
  </lk-liaoxiaoxing-moment>

  <lk-glass-surface level="lens">
    <view class="mall-entry">
      <lk-reward-glyph kind="points" value="兑换" />
      <view><text>积分好物馆</text><text class="muted">用积分兑换吃肉券与隐藏福利</text></view>
      <text class="entry-arrow">›</text>
    </view>
  </lk-glass-surface>

  <lk-glass-surface level="solid">
    <view class="progress-card">
      <view class="split-row"><text class="progress-title">等级进度</text><text class="muted">还差 72 积分升级</text></view>
      <view class="progress-track"><view></view></view>
    </view>
  </lk-glass-surface>

  <view class="task-grid section">
    <lk-glass-surface wx:for="{{rewards}}" wx:key="id" level="acrylic" interactive>
      <view class="task-card">
        <lk-reward-glyph kind="{{item.id === 'poster' ? 'ai' : item.id === 'invite' ? 'referral' : 'points'}}" state="{{item.done ? 'used' : 'active'}}" value="{{item.points}}" />
        <text class="task-title">{{item.title}}</text>
        <button class="lk-pressable" data-id="{{item.id}}" bindtap="handleReward">{{item.done ? '已完成' : item.cta}}</button>
      </view>
    </lk-glass-surface>
  </view>

  <lk-glass-surface level="solid">
    <view class="points-history">
      <view class="split-row"><text>最近积分</text><text class="muted">全部 ›</text></view>
      <view><text>扫码到店</text><text class="plus">+10</text></view>
      <view><text>使用吃肉券</text><text class="plus">+15</text></view>
    </view>
  </lk-glass-surface>
</view>
