<view class="page with-tab reward-page">
  <view class="reward-hero">
    <view>
      <text class="tiny-label">我的奖励</text>
      <text class="points">{{member.points}}</text>
      <text class="muted">燎星值 · {{member.level}}</text>
    </view>
    <image src="/assets/brand/ip/liaoxiaoxing-standalone-no-star.png" mode="aspectFit" />
  </view>

  <view class="progress-card card section">
    <view class="split-row">
      <text class="progress-title">今日进度</text>
      <text class="muted">还差 72 升级</text>
    </view>
    <view class="progress-track">
      <view></view>
    </view>
  </view>

  <view class="task-grid section">
    <view wx:for="{{rewards}}" wx:key="id" class="task-card">
      <text class="task-title">{{item.title}}</text>
      <text class="task-points">{{item.points}}</text>
      <button data-id="{{item.id}}" bindtap="handleReward">{{item.done ? '已完成' : item.cta}}</button>
    </view>
  </view>

  <mascot-card
    title="邀请好友赚燎星值"
    image-src="/assets/brand/ip/liaoxiaoxing-standalone-no-star.png"
    text="每成功邀请 1 位好友到店扫码，你可以获得 30 燎星值。"
  />
</view>
