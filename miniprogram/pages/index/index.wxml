<view class="page with-tab home-page">
  <brand-lockup />

  <view class="hero section">
    <view class="hero-copy">
      <text class="table-ip">{{store.tableIpName}} · {{store.tableName}}</text>
      <text class="store-name">{{store.name}}</text>
      <text class="store-slogan">{{store.slogan}}</text>
      <text class="hero-text">先领今天的吃肉券，再让燎小星帮你生成一张适合发朋友圈的火锅海报。</text>
    </view>
    <image class="hero-mascot" src="/assets/brand/ip/liaoxiaoxing-standalone-no-star.png" mode="aspectFit" />
  </view>

  <view class="section">
    <view class="split-row section-title">
      <view>
        <text class="tiny-label">今日福利</text>
        <text class="heading">扫码进店专属券</text>
      </view>
      <text class="muted">MVP mock</text>
    </view>
    <coupon-card wx:if="{{todayCoupon}}" coupon="{{todayCoupon}}" action-text="查看" bind:action="goCoupon" />
    <view wx:else class="claim-card card">
      <text>新会员可领一张「今日吃肉券」</text>
      <button class="primary-btn" bindtap="handleIssueCoupon">领取今日吃肉券</button>
    </view>
  </view>

  <view class="action-grid section">
    <button class="action-card" bindtap="goAiPlay">
      <text class="action-title">AI 朋友圈神器</text>
      <text class="action-body">上传随手拍，生成文案和海报。</text>
    </button>
    <button class="action-card" bindtap="goReward">
      <text class="action-title">赚燎星值</text>
      <text class="action-body">领券、创作、邀请都能得奖励。</text>
    </button>
  </view>

  <button class="group-entry section" bindtap="joinMemberGroup">
    <view>
      <text class="action-title">一键加入会员群</text>
      <text class="action-body">{{store.groupJoinGuide}}</text>
    </view>
    <image src="/assets/brand/ip/liaoxiaoxing-standalone-no-star.png" mode="aspectFit" />
  </button>

  <mascot-card
    title="燎小星"
    image-src="/assets/brand/ip/liaoxiaoxing-standalone-no-star.png"
    text="我会负责欢迎、领券、AI 创作和奖励提醒，不会强制你转发。"
  />
</view>
