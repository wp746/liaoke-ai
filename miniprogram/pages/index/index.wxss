.hero-copy {
  display: flex;
  max-width: 360rpx;
  flex-direction: column;
  gap: 12rpx;
}

.eyebrow {
  color: var(--lk-ember-600);
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.hero-title {
  color: var(--lk-ink-900);
  font-size: 45rpx;
  font-weight: 900;
  line-height: 1.14;
}

.hero-body {
  max-width: 320rpx;
  color: var(--lk-ink-600);
  font-size: 23rpx;
  line-height: 1.55;
}

.section-title {
  margin-bottom: 18rpx;
}

.section-title view {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.heading {
  color: var(--lk-ink-900);
  font-size: 38rpx;
  font-weight: 900;
}

.text-link {
  color: var(--lk-ember-600);
  font-size: 24rpx;
  font-weight: 800;
}

.claim-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 24rpx 8rpx;
}

.claim-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 7rpx;
}

.claim-copy > text:first-child {
  font-size: 29rpx;
  font-weight: 800;
}

.claim-copy .muted {
  font-size: 23rpx;
}

.claim-card + .primary-btn {
  margin: 8rpx 24rpx 24rpx;
}

.metric-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.metric-card {
  display: flex;
  min-height: 196rpx;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 18rpx;
  text-align: left;
}

.metric-card > view:last-child {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 7rpx;
}

.metric-title {
  color: var(--lk-ink-900);
  font-size: 28rpx;
  font-weight: 900;
}

.metric-card .muted {
  font-size: 21rpx;
}

.ai-entry,
.group-entry {
  display: flex;
  min-height: 154rpx;
  align-items: center;
  gap: 14rpx;
  padding: 22rpx 24rpx;
  text-align: left;
}

.ai-entry > view,
.group-entry > view {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.action-title {
  color: var(--lk-ink-900);
  font-size: 30rpx;
  font-weight: 900;
}

.action-body {
  color: var(--lk-ink-600);
  font-size: 22rpx;
  line-height: 1.48;
}

.entry-arrow {
  color: var(--lk-ember-600);
  font-size: 46rpx;
  font-weight: 400;
}
