.lk-liquid-lens {
  position: relative;
  display: flex;
  min-height: 76rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: var(--lk-radius-pill);
  color: var(--lk-ink-600);
  font-size: 24rpx;
  font-weight: 800;
  transition: color 260ms ease, transform 280ms cubic-bezier(0.2, 0.9, 0.24, 1.18);
}

.lk-liquid-lens.is-active {
  color: var(--lk-ember-600);
}

.lk-liquid-lens__trail {
  position: absolute;
  right: 22rpx;
  bottom: 8rpx;
  width: 42rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, transparent, var(--lk-reward-gold));
  animation: lk-trail-in 300ms ease both;
}

@keyframes lk-trail-in {
  from { opacity: 0; transform: translateX(-20rpx) scaleX(.5); }
  to { opacity: .78; transform: translateX(0) scaleX(1); }
}
